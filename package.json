{
  "name": "oss-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run web:build && wrangler d1 migrations apply oss-dashboard-local --local --config wrangler.local.json && wrangler dev --config wrangler.local.json --test-scheduled",
    "web:dev": "vite",
    "web:build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && wrangler deploy --dry-run --outdir .deploy --config wrangler.local.json",
    "verify": "npm run check && npm test && npm run build",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "deploy": "npm run verify && node scripts/setup-cloudflare.mjs --deploy-only",
    "selfhost": "node scripts/selfhost.mjs",
    "db:local": "wrangler d1 migrations apply oss-dashboard-local --local --config wrangler.local.json",
    "db:production": "wrangler d1 migrations apply oss-dashboard --remote --config wrangler.production.json"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.0.0"
  },
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  }
}
