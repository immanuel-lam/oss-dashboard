# Copy to .dev.vars for `npm run dev` / `npm run selfhost`, or to .env for Docker Compose.
# For Cloudflare, `npm run setup:cloudflare -- --secrets .env.production` uploads the non-empty values as Worker secrets.
# Every setting except TOKEN_ENCRYPTION_KEY is optional. A source without its settings simply stays "Not connected".

# Required. 32 random bytes, base64. Encrypts OAuth tokens in the database. Never change it after accounts are
# connected (they would have to reconnect). Generate with:  openssl rand -base64 32
# The setup and self-host scripts generate one for you when it is missing.
TOKEN_ENCRYPTION_KEY=

# Display name in the sidebar and browser tab.
DASHBOARD_NAME=Dashboard
# Public profile links shown on tiles: source=url pairs. Sources: app-store, google-play, website, tiktok,
# instagram, youtube, facebook, github.
PROFILE_URLS=

# Website analytics. Cloudflare Web Analytics is preferred; PostHog is the fallback. Never both summed.
SITE_HOSTNAMES=
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ANALYTICS_ACCOUNT=
CLOUDFLARE_ANALYTICS_SITE=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# GitHub activity: a fine-grained read-only token and owner/name pairs.
GITHUB_TOKEN=
GITHUB_REPOS=

# OAuth apps for "Connect" buttons. Callback URL: https://<your host>/oauth/<provider>/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Meta system-user tokens (alternative to the OAuth apps above; richer insights).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# App Store Connect API (Analytics Reports + optional Sales and Trends) and chart rank.
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_APP_ID=
APPLE_VENDOR_NUMBER=
APP_STORE_COUNTRY=us
APP_STORE_GENRES=
